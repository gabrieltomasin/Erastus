# LLM used for summarization — any OpenAI-compatible API
# (DeepSeek, OpenRouter, OpenAI, local llama.cpp/LM Studio, ...)
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3

# Whisper transcription
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_LANGUAGE=pt

# Uploads
UPLOAD_DIR=./data/uploads
MAX_AUDIO_SIZE_MB=2048

# Frontend origin allowed by the backend CORS
CORS_ORIGINS=http://localhost:3000

# DATABASE_URL / REDIS_URL / CELERY_* are set by docker-compose.yml
# when running in Docker; the values below are used for local development.
DATABASE_URL=postgresql+asyncpg://rpg:rpg@localhost:5432/rpgsummary
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
